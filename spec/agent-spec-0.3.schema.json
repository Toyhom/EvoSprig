{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 32,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_model_calls": {
          "default": 8,
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 8192,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 512,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "image_token_reserve": {
          "default": 4096,
          "maximum": 65536,
          "minimum": 256,
          "title": "Image Token Reserve",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_parallel_nodes": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Parallel Nodes",
          "type": "integer"
        },
        "max_parallel_tools": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Parallel Tools",
          "type": "integer"
        },
        "allow_side_effects": {
          "default": false,
          "title": "Allow Side Effects",
          "type": "boolean"
        },
        "pure_checkpoint_interval": {
          "default": 1,
          "maximum": 128,
          "minimum": 1,
          "title": "Pure Checkpoint Interval",
          "type": "integer"
        }
      },
      "title": "Execution",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "title": "Entry",
          "type": "string"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/Node"
          },
          "maxProperties": 512,
          "minProperties": 1,
          "title": "Nodes",
          "type": "object"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 4096,
          "title": "Edges",
          "type": "array"
        },
        "output": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Ref"
              },
              {
                "$ref": "#/$defs/Value"
              }
            ]
          },
          "title": "Output",
          "type": "object"
        }
      },
      "required": [
        "entry",
        "nodes",
        "output"
      ],
      "title": "Graph",
      "type": "object"
    },
    "Harness": {
      "additionalProperties": false,
      "description": "Optional per-agent overrides; omitted values retain the node's settings.",
      "properties": {
        "max_tool_rounds": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Rounds"
        },
        "tool_selection": {
          "anyOf": [
            {
              "enum": [
                "all",
                "relevant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Selection"
        },
        "tool_limit": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Limit"
        },
        "parallel_tool_calls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parallel Tool Calls"
        },
        "tool_errors": {
          "anyOf": [
            {
              "enum": [
                "raise",
                "feedback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Errors"
        },
        "output_errors": {
          "anyOf": [
            {
              "enum": [
                "raise",
                "feedback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Errors"
        },
        "max_output_retries": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Retries"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "maximum": 32768,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "max_tool_result_chars": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 512,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Result Chars"
        },
        "tool_history": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolHistoryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Harness",
      "type": "object"
    },
    "MemoryPolicy": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "query_input": {
          "title": "Query Input",
          "type": "string"
        },
        "limit": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "max_chars": {
          "default": 4000,
          "maximum": 16000,
          "minimum": 128,
          "title": "Max Chars",
          "type": "integer"
        }
      },
      "required": [
        "tool",
        "query_input"
      ],
      "title": "MemoryPolicy",
      "type": "object"
    },
    "ModelRequirement": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Binding",
          "type": "string"
        },
        "requires": {
          "items": {
            "enum": [
              "text",
              "tool_calling",
              "structured_output",
              "vision"
            ],
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "binding"
      ],
      "title": "ModelRequirement",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "model",
            "agent",
            "tool",
            "transform",
            "condition",
            "join",
            "loop",
            "parallel",
            "map",
            "human",
            "code"
          ],
          "title": "Type",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Ref"
              },
              {
                "$ref": "#/$defs/Value"
              }
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ResourceRef"
            }
          ],
          "default": "",
          "title": "Instructions"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Skills",
          "type": "array"
        },
        "image_inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Image Inputs",
          "type": "array"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "response_format": {
          "default": "text",
          "enum": [
            "text",
            "json"
          ],
          "title": "Response Format",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Graph"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "branches": {
          "additionalProperties": {
            "$ref": "#/$defs/Graph"
          },
          "maxProperties": 16,
          "title": "Branches",
          "type": "object"
        },
        "max_iterations": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "until": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "join": {
          "default": "all",
          "enum": [
            "all",
            "selected"
          ],
          "title": "Join",
          "type": "string"
        },
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items"
        },
        "carry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carry"
        },
        "max_items": {
          "default": 32,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "tool_errors": {
          "default": "raise",
          "enum": [
            "raise",
            "feedback"
          ],
          "title": "Tool Errors",
          "type": "string"
        },
        "parallel_tool_calls": {
          "default": false,
          "title": "Parallel Tool Calls",
          "type": "boolean"
        },
        "tool_selection": {
          "default": "all",
          "enum": [
            "all",
            "relevant"
          ],
          "title": "Tool Selection",
          "type": "string"
        },
        "tool_limit": {
          "default": 8,
          "maximum": 64,
          "minimum": 1,
          "title": "Tool Limit",
          "type": "integer"
        },
        "max_tool_rounds": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tool Rounds"
        },
        "output_errors": {
          "default": "raise",
          "enum": [
            "raise",
            "feedback"
          ],
          "title": "Output Errors",
          "type": "string"
        },
        "max_output_retries": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Output Retries",
          "type": "integer"
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "maximum": 32768,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Harness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Validator"
        },
        "mailbox": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mailbox"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_max_value_chars": {
          "anyOf": [
            {
              "maximum": 8388608,
              "minimum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Max Value Chars"
        }
      },
      "required": [
        "type",
        "output_schema"
      ],
      "title": "Node",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "$ref": "#/$defs/Value"
            }
          ],
          "title": "Left"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "contains",
            "truthy"
          ],
          "title": "Op",
          "type": "string"
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        }
      },
      "required": [
        "left",
        "op"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "default": {
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "default": "prompt",
          "enum": [
            "prompt",
            "skill",
            "code"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "Resource",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "resource": {
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "resource"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ToolBinding": {
      "additionalProperties": false,
      "properties": {
        "plugin": {
          "title": "Plugin",
          "type": "string"
        },
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "plugin"
      ],
      "title": "ToolBinding",
      "type": "object"
    },
    "ToolHistoryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_chars": {
          "default": 16000,
          "maximum": 1000000,
          "minimum": 512,
          "title": "Max Chars",
          "type": "integer"
        },
        "keep_recent_rounds": {
          "default": 2,
          "maximum": 32,
          "minimum": 0,
          "title": "Keep Recent Rounds",
          "type": "integer"
        }
      },
      "title": "ToolHistoryPolicy",
      "type": "object"
    },
    "Value": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "Value",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "default": "0.1",
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ],
      "title": "Spec Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelRequirement"
      },
      "title": "Models",
      "type": "object"
    },
    "tools": {
      "additionalProperties": {
        "$ref": "#/$defs/ToolBinding"
      },
      "title": "Tools",
      "type": "object"
    },
    "resources": {
      "additionalProperties": {
        "$ref": "#/$defs/Resource"
      },
      "title": "Resources",
      "type": "object"
    },
    "graph": {
      "$ref": "#/$defs/Graph"
    },
    "execution": {
      "$ref": "#/$defs/Execution"
    }
  },
  "required": [
    "id",
    "input_schema",
    "output_schema",
    "graph"
  ],
  "title": "AgentSpec",
  "type": "object"
}
