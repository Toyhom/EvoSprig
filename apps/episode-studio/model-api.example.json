{
  "main": {
    "base_url": "https://api.openai.com/v1",
    "model": "your-multimodal-model-id",
    "api_key_env": "EPISODE_MODEL_API_KEY",
    "timeout_seconds": 300,
    "max_connections": 8,
    "max_keepalive_connections": 4,
    "json_mode": "without_tools",
    "capabilities": [
      "text",
      "structured_output",
      "vision"
    ]
  }
}
